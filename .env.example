# ============================================
# Alpha-Prime Trading System - Environment Config
#
# Copy to .env and fill in. The .env file is gitignored and must never be
# committed. The hosted demo runs with DEMO_MODE=true and no credentials.
# ============================================

# --- Demo mode ---
# Read-only showcase over the committed snapshot in data/demo/. Disables
# broker execution, the LLM pipeline and all credential writes. The public
# Streamlit deployment forces this on via streamlit_app.py.
DEMO_MODE=false

# --- Groww API (update daily - keys expire every day) ---
GROWW_API_KEY=
GROWW_SECRET_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# --- Trading Config ---
TRADING_MODE=paper
TRADING_CAPITAL=1000000
MARGIN_MULTIPLIER=5
MAX_DAILY_LOSS_PCT=2.0
# Notional cap per position as a % of REAL capital (NOT margin buying power).
# Caps overnight-gap exposure on one name. 20% of Rs.10L = Rs.2L max/position.
# (The old "25% of effective/margin capital" allowed Rs.12.5L into one stock -
# the DIVISLAB/ZYDUSLIFE blow-ups.)
MAX_POSITION_SIZE_PCT=20
MAX_OPEN_POSITIONS=10
DEFAULT_STOP_LOSS_PCT=1.2
# Raised 1.8 -> 2.5 based on the backtest parameter sweep (run_sweep.py): target 2.5%
# netted the most AFTER costs on both 5- and 12-symbol NIFTY sets over 60d (wider
# targets clear the ~Rs130 round-trip cost hurdle). R:R = 2.5/1.2 = 2.08:1.
# NOTE: this is IN-SAMPLE on 60d of data - validate out-of-sample before live.
DEFAULT_TARGET_PCT=2.5
DAILY_PROFIT_TARGET_PCT=1.5
MIN_SIGNAL_STRENGTH=0.25

# --- Risk-based position sizing (PRIMARY size control, enforced in code) ---
# Max % of REAL capital lost if a trade hits its stop. Sizes quantity so a
# stop-out costs ~Rs.5k on Rs.10L, not Rs.17k+. This usually binds before the
# notional cap above.
RISK_PER_TRADE_PCT=0.5

# --- Exit management (trailing stop) ---
# Move stop to breakeven once up this %; start trailing only past TRAIL_ARM_PCT;
# then trail TRAILING_STOP_PCT below the peak. Stops winners being cut at ~+0.5%.
BREAKEVEN_ARM_PCT=0.6
TRAIL_ARM_PCT=1.0
TRAILING_STOP_PCT=1.0

# --- Trading Time Window ---
# Only place NEW BUY trades between these times (IST)
# Before start: system watches but doesn't buy (morning volatility)
# After end: no new trades, let existing positions play out
TRADING_START_HOUR=10
TRADING_START_MINUTE=0
TRADING_END_HOUR=14
TRADING_END_MINUTE=30

# --- Scheduler ---
ANALYSIS_INTERVAL_MINUTES=15
